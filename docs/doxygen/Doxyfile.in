# Configuration file for the `doxygen` documentation generator.
#
# This file is processed by `cmake`: the `@...@` substitutions are
# replaced by their value at configuration time. The documentation is
# generated by building the `doc` target:
#
#   cmake --build <build-dir> --target doc

PROJECT_NAME           = MFrontJIT
PROJECT_BRIEF          = "Just in time compilation of MFront implementations"

OUTPUT_DIRECTORY       = @CMAKE_CURRENT_BINARY_DIR@
OUTPUT_LANGUAGE        = English
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = @CMAKE_SOURCE_DIR@
STRIP_FROM_INC_PATH    = @CMAKE_SOURCE_DIR@/include
TAB_SIZE               = 2
MARKDOWN_SUPPORT       = YES

# Only the public interface is documented: the `.hxx` files are processed,
# the `.cxx` files are not, as in `TFEL`, and an undocumented entity of the
# public interface is reported as a warning.
INPUT                  = @CMAKE_SOURCE_DIR@/include
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.hxx
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */docs/*
EXTRACT_ALL            = NO
EXTRACT_STATIC         = NO
WARN_IF_UNDOCUMENTED   = YES

# `MFRONTJIT_EXPORT` is an annotation of the public symbols, not a part of
# the signature, so it is expanded to nothing before the sources are
# parsed.
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
PREDEFINED             = MFRONTJIT_EXPORT=
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = @CMAKE_SOURCE_DIR@/include

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_XML           = NO

WARNINGS               = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
# a missing or inconsistent comment in the public interface is a defect of
# the documentation: it shall break the `doc` target, as the continuous
# integration of `TFEL` does.
WARN_AS_ERROR          = YES
QUIET                  = YES
